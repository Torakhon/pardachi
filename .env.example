# ================== Docker Compose uchun umumiy sozlamalar ==================
# Ushbu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env

# ---------- PostgreSQL ----------
POSTGRES_USER=pardachi
POSTGRES_PASSWORD=pardachi
POSTGRES_DB=pardachi
POSTGRES_PORT=5432

# ---------- Portlar ----------
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ---------- Muhit ----------
ENVIRONMENT=production
LOG_LEVEL=INFO

# ---------- Xavfsizlik ----------
# Majburiy! Yangi kalit yaratish: openssl rand -hex 32
SECRET_KEY=

# ---------- Telegram ----------
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=pardachi_bot
# Admin bo'ladigan Telegram ID lar (vergul bilan): 123456789,987654321
ADMIN_TELEGRAM_IDS=
FIRST_USER_IS_ADMIN=true
ALLOW_SELF_REGISTRATION=true
# Mini App ochiladigan HTTPS manzil (bot uchun)
WEBAPP_URL=https://example.com

# ---------- Rasm saqlash ----------
# local — server diskida (media hajmi), telegram — Telegram File API
STORAGE_BACKEND=local
TELEGRAM_STORAGE_CHAT_ID=
MAX_UPLOAD_SIZE_MB=12

# ---------- Front-end ----------
# Bo'sh qoldiring — nginx `/api` ni backendga proksi qiladi.
# Alohida domen ishlatilsa: https://api.example.com
VITE_API_BASE_URL=
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---------- Development ----------
ALLOW_DEV_LOGIN=false
DEV_LOGIN_SECRET=dev-secret
# Konteyner birinchi ishga tushganda namunaviy ma'lumot yuklansinmi
RUN_SEED=false
