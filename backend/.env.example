# ============ Umumiy ============
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# ============ Ma'lumotlar bazasi ============
DATABASE_URL=postgresql+asyncpg://pardachi:pardachi@localhost:5432/pardachi
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============ Xavfsizlik ============
# Ishlab chiqarishda albatta o'zgartiring: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# ============ Telegram ============
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=pardachi_bot
# Vergul bilan ajratilgan telegram ID lar — avtomatik admin bo'ladi
ADMIN_TELEGRAM_IDS=
FIRST_USER_IS_ADMIN=true
ALLOW_SELF_REGISTRATION=true

# ============ Dev login (Telegramsiz sinov) ============
ALLOW_DEV_LOGIN=true
DEV_LOGIN_SECRET=dev-secret

# ============ Fayl saqlash ============
# local | telegram
STORAGE_BACKEND=local
MEDIA_URL_PREFIX=/media
MAX_UPLOAD_SIZE_MB=12
IMAGE_MAX_DIMENSION=1600
IMAGE_QUALITY=82
# STORAGE_BACKEND=telegram bo'lganda rasm yuboriladigan chat (masalan: -1001234567890)
TELEGRAM_STORAGE_CHAT_ID=

# ============ CORS ============
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
CORS_ALLOW_ALL=false

# ============ Limitlar ============
RATE_LIMIT_PER_MINUTE=240
